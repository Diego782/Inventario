# Conexión Prisma (Next.js la lee automáticamente)
DATABASE_URL="mysql://invenpro:invenpro@localhost:3306/invenpro?charset=utf8mb4"

# Variables consumidas por docker compose
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=invenpro
MYSQL_USER=invenpro
MYSQL_PASSWORD=invenpro_password_change_me

# Zona horaria del servidor (afecta la generación de folios diarios)
TZ=America/Mexico_City

# Nombre de la impresora térmica de etiquetas (CUPS).
# Ver impresoras disponibles con: lpstat -p
# Si no se define, /api/productos/[id]/imprimir-etiqueta devuelve el PDF en lugar de imprimir.
PRINTER_NAME=
