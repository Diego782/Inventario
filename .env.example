# Conexión Prisma (Next.js la lee automáticamente)
DATABASE_URL="mysql://invenpro:invenpro@localhost:3306/invenpro?charset=utf8mb4"

# Variables consumidas por docker compose
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=invenpro
MYSQL_USER=invenpro
MYSQL_PASSWORD=invenpro_password_change_me

# Zona horaria del servidor (afecta la generación de folios diarios)
TZ=America/Mexico_City

# Nombre de la impresora térmica de etiquetas (CUPS).
# Ver impresoras disponibles con: lpstat -p
# Si no se define, /api/productos/[id]/imprimir-etiqueta devuelve el PDF en lugar de imprimir.
PRINTER_NAME=

# --- Sesiones y tokens (usuarios-y-accesos) ---
# Vida de la sesión por inactividad. Rango 1h..30d. Default 7d.
SESION_INACTIVIDAD_HORAS=168
# Vigencia del token de verificación de correo. Rango 1..168h. Default 24h.
VERIFICACION_TOKEN_HORAS=24
# Vigencia del token de invitación. Default 72h.
INVITACION_TOKEN_HORAS=72
# Coste de bcrypt (rondas). Default 12.
BCRYPT_COST=12

# Origen público de la app, usado para construir enlaces de correo.
APP_URL=http://localhost:3000

# --- Servicio de correo (SMTP de costo cero) ---
# Si SMTP_HOST/SMTP_USER/SMTP_PASSWORD faltan, los correos se imprimen en consola.
# Ejemplo con Brevo (capa gratuita): smtp-relay.brevo.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dego <no-reply@dego.local>"
SMTP_SECURE=false
